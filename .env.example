# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ============================================================================
# SERVICIO DE NOTIFICACIONES POR CORREO ELECTRÓNICO (RESEND API) — POZO DEL CARRIL
# Las credenciales se configuran exclusivamente en el backend (Secretos de AI Studio)
# ============================================================================

# Clave secreta de la API de Resend (https://resend.com/api-keys)
RESEND_API_KEY=""

# Remitente autorizado en Resend.
# Si aún no hay un dominio propio verificado en https://resend.com/domains, se utiliza
# "Pozo del Carril <onboarding@resend.dev>" (permite envíos reales únicamente al correo
# titular de la cuenta de Resend). Una vez verificado un dominio propio, configure por ejemplo:
# RESEND_FROM="Pozo del Carril <notificaciones@tudominio.com>"
RESEND_FROM="Pozo del Carril <onboarding@resend.dev>"

